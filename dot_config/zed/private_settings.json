// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "disable_ai": false,
  "edit_predictions": {
    "provider": "zed",
  },
  "cli_default_open_behavior": "new_window",
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "buffer_font_weight": 400.0,
  "outline_panel": {
    "dock": "left",
    "indent_size": 20.0,
    "default_width": 253.0,
  },
  "project_panel": {
    "dock": "left",
    "indent_size": 10.0,
    "default_width": 150.0,
  },
  "show_edit_predictions": false,
  "ssh_connections": [
    {
      "host": "perche.saclay.inria.fr",
      "username": "admin",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/admin/wkdir/src"
          ]
        },
        {
          "paths": [
            "/home/admin/wkdir/src/guix"
          ]
        }
      ]
    },
    {
      "host": "perche.saclay.inria.fr",
      "username": "admin",
      "args": [],
      "projects": []
    }
  ],
  "agent": {
    "dock": "right",
    "default_model": {
      "provider": "ollama",
      "model": "hf.co/TheBloke/deepseek-coder-6.7B-instruct-GGUF:Q2_K",
    },
  },
  "vim_mode": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme",
  },
  "ui_font_size": 14.0,
  "buffer_font_size": 12.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Dracula",
  },
  "auto_install_extensions": {
    "html": true,
    "dracula": true,
    "material-icon-theme": true,
    "toml": true,
  },
  "lsp": {
    "clangd": {
      "binary": {
        "path": "/opt/homebrew/opt/llvm/bin/clangd",
        "arguments": [],
      },
    },
    "texlab": {
      "settings": {
        "texlab": {
          "build": {
            "onSave": false,
          },
        },
      },
    },
  },
  "languages": {
    "LaTeX": {
      "formatter": {
        "external": {
          "command": "latexindent", // or choose specific path
          "arguments": ["--modifylinebreaks", "-g", "/tmp/indent.log"], // control behaviour with flags
        },
      },
    },
  },
}
